{
  "name": "@passa-a-regua/sidecar",
  "private": true,
  "version": "0.1.0",
  "description": "Processo sidecar Node embutido no app Tauri via SEA (Single Executable Application) — ARCH §9, M2.",
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:node:sqlite",
    "build:sea": "node scripts/build-sea.mjs",
    "build": "npm run typecheck && npm run build:bundle && npm run build:sea",
    "test:concurrency": "npm run build:bundle && node test/concurrency-scenario.mjs"
  },
  "dependencies": {
    "@passa-a-regua/shared-types": "*",
    "@passa-a-regua/sync-engine": "*",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  }
}
