{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabwise",
  "version": "0.1.0",
  "identifier": "dev.eudesjr.tabwise",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tabwise",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecar/tabwise-sidecar"
    ],
    "publisher": "Eudes Junior",
    "copyright": "© 2026 Eudes Junior",
    "category": "Business",
    "shortDescription": "Offline-first point of sale for bars and restaurants",
    "longDescription": "Tabwise is an offline-first point of sale for bars and restaurants: tables, tabs, menu, cash register and reports, all working without internet.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
